# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA versione o ".env" (já está no .gitignore).

# Obrigatória — o app recusa subir sem ela.
# Gere um valor aleatório próprio, por exemplo:
#   python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=

# ID da pasta raiz no Google Drive onde ficam as pastas ANO/SALA/ALUNOS/...
# Deixe em branco (ou com o placeholder) para o app rodar sem Drive,
# salvando os uploads localmente em uploads/.
DRIVE_ROOT_FOLDER_ID=COLE_O_ID_DA_PASTA_RAIZ_AQUI
